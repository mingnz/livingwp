---
/**
 * The monthly run, animated step by step on a loop. Steps advance when each
 * button's progress fill completes (a GSAP tween), so pausing the tween pauses
 * the loop. Node and connector states are classes toggled per step; GSAP adds
 * the one-off flourishes (source chips, typing lines, archive tilt, PR badge).
 *
 * Without JS, every step's caption is listed. With reduced motion, the loop
 * starts paused and steps change only on click.
 */
const steps = [
  {
    title: 'The month begins',
    body: 'On the 1st, a GitHub Actions workflow starts a run for every sector. Maintainers can also start a run by hand.',
  },
  {
    title: 'Read last month',
    body: 'The research agent loads the current edition first, so it knows what it already said and what to check.',
  },
  {
    title: 'Search the web',
    body: 'It runs live searches for news, research and case studies published since the last edition.',
  },
  {
    title: 'Write the new edition',
    body: 'It writes a fresh edition with sources cited inline. The previous edition moves to the archive, unchanged.',
  },
  {
    title: 'Merge a pull request',
    body: 'The change lands as a pull request that merges automatically and stays on GitHub as the audit trail.',
  },
  {
    title: 'Publish',
    body: 'The site rebuilds and the new edition goes live at the same address. The previous edition keeps its own dated address.',
  },
];

const chips = [
  { label: 'stats.govt.nz', x: 176, y: 14 },
  { label: 'digital.govt.nz', x: 540, y: 14 },
  { label: 'rnz.co.nz', x: 150, y: 54 },
  { label: 'research papers', x: 556, y: 54 },
];

---

<div data-pipeline class="rounded-[1.75rem] bg-mist p-6 sm:p-10">
  <!-- Desktop stage: fixed 1040×350 coordinate space, zoomed to fit. -->
  <div class="hidden md:block" data-stage-wrap>
    <div class="relative mx-auto h-[350px] w-[1040px]" data-stage>
      <div class="conn flow-x left-[180px] top-[212px] h-1 w-[110px]" data-flow="trig"></div>
      <div class="conn flow-y left-[418px] top-[86px] h-16 w-1" data-flow="search"></div>
      <div class="conn flow-x left-[550px] top-[212px] h-1 w-20" data-flow="write"></div>
      <div class="conn flow-x left-[800px] top-[212px] h-1 w-[70px]" data-flow="ship"></div>
      <div class="conn flow-yr left-[713px] top-[116px] h-[46px] w-1" data-flow="read"></div>
      <div class="conn flow-xr left-[500px] top-[116px] h-1 w-[217px]" data-flow="read"></div>
      <div class="conn flow-y left-[500px] top-[116px] h-[34px] w-1" data-flow="read"></div>
      <span class="absolute top-[94px] left-[580px] text-xs font-medium text-ink-muted">reads previous</span>

      <div class="node node-search absolute top-2.5 left-[320px] h-[76px] w-[200px] px-[18px] py-3.5" data-node="search">
        <span class="flex items-center gap-2.5 text-[17px] font-semibold">
          <svg class="size-[18px]" viewBox="0 0 18 18" aria-hidden="true">
            <circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
            <path d="M12.5 12.5L16 16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
          </svg>
          Web search
        </span>
        <span class="mt-1 block text-[13px] opacity-80">Live sources, cited inline</span>
      </div>
      {
        chips.map((c) => (
          <span
            class="chip absolute rounded-full border border-line-strong bg-white px-3 py-1.5 text-[13px] font-medium text-teal opacity-0"
            style={`left:${c.x}px;top:${c.y}px`}
            data-chip
          >
            {c.label}
          </span>
        ))
      }

      <div class="node absolute top-[172px] left-0 flex h-[84px] w-[180px] items-center gap-3 px-4 py-3.5" data-node="trig">
        <span class="flex h-11 w-10 flex-none flex-col overflow-hidden rounded-lg border-[1.5px] border-current text-center" aria-hidden="true">
          <span class="bg-lime py-0.5 text-[9px] font-bold tracking-wider text-ink">MONTH</span>
          <span class="text-lg leading-snug font-bold">1</span>
        </span>
        <span>
          <span class="block text-[17px] font-semibold">Pipeline</span>
          <span class="block text-[13px] opacity-80">GitHub Actions</span>
        </span>
      </div>

      <div class="node node-agent absolute top-[150px] left-[290px] h-32 w-[260px] px-[22px] py-5" data-node="agent">
        <span class="flex items-center justify-between">
          <span class="text-xl font-bold">Research agent</span>
          <span class="spinner size-[18px] rounded-full border-[2.5px] border-white/25 border-t-lime-soft" aria-hidden="true"></span>
        </span>
        <span class="mt-1 block text-[13px] text-teal-mint">Frontier model · Vercel AI SDK</span>
        <span class="mt-3.5 inline-flex rounded-full bg-white/12 px-3 py-1 text-[13px] font-medium" data-agent-status>
          Waiting for trigger
        </span>
      </div>

      <div class="node absolute top-[162px] left-[630px] h-[104px] w-[170px] px-4 py-3.5" data-node="md">
        <span class="flex items-start gap-3">
          <span class="relative h-[46px] w-[38px] flex-none" aria-hidden="true">
            <span class="absolute inset-0 rounded-[5px] border border-line-strong bg-line-soft" data-archive></span>
            <span class="absolute inset-0 flex flex-col gap-1 overflow-hidden rounded-[5px] border-[1.5px] border-teal bg-white px-1.5 py-[7px]">
              <span class="h-[3px] w-[22px] origin-left rounded-sm bg-teal" data-line></span>
              <span class="h-[3px] w-[18px] origin-left rounded-sm bg-teal-bright" data-line></span>
              <span class="h-[3px] w-[22px] origin-left rounded-sm bg-teal-bright" data-line></span>
              <span class="h-[3px] w-3.5 origin-left rounded-sm bg-teal-bright" data-line></span>
            </span>
          </span>
          <span>
            <span class="block text-[17px] font-semibold">Markdown</span>
            <span class="block text-[13px] opacity-80" data-md-status>Current edition</span>
          </span>
        </span>
      </div>

      <div class="node node-site absolute top-[172px] left-[870px] h-[84px] w-[170px] px-4 py-3.5" data-node="site">
        <span class="flex items-center gap-2 text-[17px] font-semibold">
          <span class="site-dot live-dot bg-ink" aria-hidden="true"></span>
          Website
        </span>
        <span class="mt-1 block text-[13px] opacity-85" data-site-status>Serving last edition</span>
      </div>

      <div
        class="absolute top-[284px] left-[730px] flex items-center gap-2.5 rounded-[14px] border-[1.5px] border-teal bg-white px-4 py-2.5 opacity-0 shadow-[0_12px_30px_-18px_rgb(16_41_44/0.5)]"
        data-pr
      >
        <span class="flex size-6 items-center justify-center rounded-full bg-[#8250df]" aria-hidden="true">
          <svg class="size-3.5" viewBox="0 0 14 14">
            <path d="M3 7.5l2.5 2.5L11 4.5" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="text-sm font-semibold">Pull request merged</span>
      </div>
    </div>
  </div>

  <!-- Phones: the same flow stacked vertically, web search branching off the agent. -->
  <div class="flex flex-col md:hidden" data-mobile aria-hidden="true">
    <div class="node flex items-center gap-3 px-4 py-3" data-node="trig">
      <span class="flex h-10 w-9 flex-none flex-col overflow-hidden rounded-md border-[1.5px] border-current text-center">
        <span class="bg-lime text-[8px] font-bold tracking-wider text-ink">MONTH</span>
        <span class="text-base leading-snug font-bold">1</span>
      </span>
      <span>
        <span class="block font-semibold">Pipeline</span>
        <span class="block text-sm opacity-80">GitHub Actions</span>
      </span>
    </div>

    <div class="conn flow-y ml-9 h-6 w-1" data-flow="trig"></div>

    <div class="flex items-center">
      <div class="node node-agent min-w-0 flex-1 px-4 py-3.5" data-node="agent">
        <span class="flex items-center justify-between gap-2">
          <span class="font-bold">Research agent</span>
          <span class="spinner size-4 flex-none rounded-full border-2 border-white/25 border-t-lime-soft"></span>
        </span>
        <span class="mt-2 inline-flex rounded-full bg-white/12 px-2.5 py-0.5 text-xs font-medium" data-agent-status>
          Waiting for trigger
        </span>
      </div>
      <div class="conn flow-xr h-1 w-4 flex-none" data-flow="search"></div>
      <div class="node node-search w-[7.5rem] flex-none px-3 py-3" data-node="search">
        <span class="block text-sm font-semibold">Web search</span>
        <span class="block text-xs opacity-80">Live sources</span>
      </div>
    </div>

    <div class="flex items-start justify-between gap-3">
      <!-- Agent ⇄ Markdown: reads the previous edition up, writes the new one down. -->
      <div class="relative ml-9 h-14 w-1 flex-none">
        <div class="conn flow-yr absolute inset-0" data-flow="read"></div>
        <div class="conn flow-y absolute inset-0" data-flow="write"></div>
      </div>
      <span class="mt-2 flex flex-wrap justify-end gap-1">
        {
          chips.map((c) => (
            <span class="chip rounded-full border border-line-strong bg-white px-2 py-0.5 text-[11px] font-medium text-teal opacity-0" data-chip>
              {c.label}
            </span>
          ))
        }
      </span>
    </div>

    <div class="node flex items-center gap-3 px-4 py-3" data-node="md">
      <span class="relative h-10 w-8 flex-none">
        <span class="absolute inset-0 rounded border border-line-strong bg-line-soft" data-archive></span>
        <span class="absolute inset-0 flex flex-col gap-1 overflow-hidden rounded border-[1.5px] border-teal bg-white px-1.5 py-1.5">
          <span class="h-[3px] w-full origin-left rounded-sm bg-teal" data-line></span>
          <span class="h-[3px] w-3/4 origin-left rounded-sm bg-teal-bright" data-line></span>
          <span class="h-[3px] w-full origin-left rounded-sm bg-teal-bright" data-line></span>
        </span>
      </span>
      <span>
        <span class="block font-semibold">Markdown</span>
        <span class="block text-sm opacity-80" data-md-status>Current edition</span>
      </span>
    </div>

    <div class="flex items-center gap-3">
      <div class="conn flow-y ml-9 h-12 w-1 flex-none" data-flow="ship"></div>
      <span class="inline-flex items-center gap-1.5 rounded-full border-[1.5px] border-teal bg-white px-2.5 py-1 text-xs font-semibold opacity-0" data-pr>
        <span class="flex size-4 items-center justify-center rounded-full bg-[#8250df]">
          <svg class="size-2.5" viewBox="0 0 14 14">
            <path d="M3 7.5l2.5 2.5L11 4.5" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        Pull request merged
      </span>
    </div>

    <div class="node node-site px-4 py-3" data-node="site">
      <span class="flex items-center gap-2 font-semibold">
        <span class="site-dot live-dot bg-ink"></span>
        Website
      </span>
      <span class="block text-sm opacity-85" data-site-status>Serving last edition</span>
    </div>
  </div>

  <div class="mt-6 flex flex-wrap items-start gap-x-10 gap-y-6 border-t border-line pt-6">
    <ol class="min-h-28 flex-[1_1_22rem]" aria-live="polite">
      {
        steps.map((s, i) => (
          <li class:list={['caption', i === 0 && 'is-active']} data-caption>
            <p class="text-[13px] font-semibold tracking-[0.08em] text-teal uppercase">
              Step {i + 1} of {steps.length}
            </p>
            <h3 class="mt-2 text-[1.75rem] leading-tight font-bold tracking-tight">{s.title}</h3>
            <p class="mt-2.5 max-w-xl font-serif text-lg leading-normal text-ink-soft">{s.body}</p>
          </li>
        ))
      }
    </ol>
    <div class="flex flex-[1_1_22rem] flex-col gap-3 [@media(scripting:none)]:hidden">
      <div class="grid grid-cols-6 gap-1.5">
        {
          steps.map((s, i) => (
            <button
              type="button"
              class="relative h-11 overflow-hidden rounded-[10px] bg-white text-sm font-semibold transition-colors hover:bg-teal-pale"
              aria-label={`Step ${i + 1}: ${s.title}`}
              data-goto={i}
            >
              <span class="absolute inset-0 origin-left scale-x-0 bg-lime-pale" data-done></span>
              <span class="absolute inset-0 origin-left scale-x-0 bg-lime-soft" data-fill></span>
              <span class="relative">{i + 1}</span>
            </button>
          ))
        }
      </div>
      <button
        type="button"
        class="inline-flex h-11 items-center gap-2 self-start rounded-full border-[1.5px] border-line-strong bg-white px-4 text-sm font-semibold"
        data-toggle
      >
        <svg class="size-3.5" viewBox="0 0 14 14" aria-hidden="true" data-icon-pause>
          <path d="M4 2.5v9M10 2.5v9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
        </svg>
        <svg class="hidden size-3.5" viewBox="0 0 14 14" aria-hidden="true" data-icon-play>
          <path d="M3.5 2.5l8 4.5-8 4.5z" fill="currentColor"></path>
        </svg>
        <span data-toggle-label>Pause</span>
      </button>
    </div>
  </div>
</div>

<style>
  .node {
    border-radius: 1rem;
    border: 1.5px solid var(--color-line-strong);
    background: white;
    transition:
      transform 0.5s var(--ease-out-expo),
      border-color 0.4s,
      box-shadow 0.5s,
      background-color 0.5s,
      color 0.5s,
      opacity 0.5s;
  }

  [data-stage] .node {
    position: absolute;
  }

  [data-mobile] .node.is-on {
    transform: scale(1.02);
  }

  .node.is-on {
    border-color: var(--color-teal);
    box-shadow: 0 18px 40px -20px rgb(22 93 97 / 0.55);
    transform: scale(1.05);
  }

  .node.is-dim {
    opacity: 0.55;
  }

  .node-agent {
    border: 0;
    border-radius: 1.25rem;
    background: var(--color-teal);
    color: white;
  }

  .node-agent.is-on {
    box-shadow: 0 24px 50px -22px rgb(22 93 97 / 0.8);
  }

  .node-search {
    border-style: dashed;
    border-color: var(--color-teal-bright);
    background: #f8fbfa;
    color: var(--color-ink-soft);
  }

  .node-search.is-on {
    border-style: solid;
    background: white;
    color: var(--color-ink);
  }

  .node-site.is-on {
    border-color: var(--color-lime);
    background: var(--color-lime);
    color: var(--color-ink);
    box-shadow: 0 18px 40px -20px rgb(56 196 14 / 0.8);
  }

  .spinner,
  .site-dot {
    visibility: hidden;
  }

  .node-agent.is-on .spinner {
    visibility: visible;
    animation: spin 1.1s linear infinite;
  }

  .node-site.is-on .site-dot {
    visibility: visible;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Connectors: grey at rest, a marching lime dash while data flows. */
  [data-stage] .conn {
    position: absolute;
  }

  .conn {
    border-radius: 4px;
    background: var(--color-line);
  }

  .conn.is-flowing.flow-x,
  .conn.is-flowing.flow-xr {
    background: repeating-linear-gradient(90deg, var(--color-lime) 0 10px, var(--color-lime-pale) 10px 18px);
    background-size: 18px 100%;
  }

  .conn.is-flowing.flow-y,
  .conn.is-flowing.flow-yr {
    background: repeating-linear-gradient(180deg, var(--color-lime) 0 10px, var(--color-lime-pale) 10px 18px);
    background-size: 100% 18px;
  }

  .conn.is-flowing.flow-x {
    animation: march-x 0.45s linear infinite;
  }
  .conn.is-flowing.flow-xr {
    animation: march-x 0.45s linear infinite reverse;
  }
  .conn.is-flowing.flow-y {
    animation: march-y 0.45s linear infinite;
  }
  .conn.is-flowing.flow-yr {
    animation: march-y 0.45s linear infinite reverse;
  }

  @keyframes march-x {
    to {
      background-position: 18px 0;
    }
  }

  @keyframes march-y {
    to {
      background-position: 0 18px;
    }
  }

  @media (scripting: enabled) {
    .caption:not(.is-active) {
      display: none;
    }
  }

  @media (scripting: none) {
    .caption + .caption {
      margin-top: 1.5rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const STEP_SECONDS = 3.6;

  // Which nodes are lit, which connectors flow, and the status labels, per step.
  const STATES = [
    { on: ['trig'], flow: ['trig'], agent: 'Waiting for trigger', md: 'Current edition', site: 'Serving last edition' },
    { on: ['agent', 'md'], flow: ['read'], agent: 'Reading previous edition', md: 'Current edition', site: 'Serving last edition' },
    { on: ['agent', 'search'], flow: ['search'], agent: 'Searching the web', md: 'Current edition', site: 'Serving last edition' },
    { on: ['agent', 'md'], flow: ['write'], agent: 'Writing new edition', md: 'New edition saved', site: 'Serving last edition' },
    { on: [], flow: ['ship'], agent: 'Run complete', md: 'Edition ready', site: 'Serving last edition' },
    { on: ['site'], flow: ['ship'], agent: 'Run complete', md: 'Edition ready', site: 'New edition live' },
  ];
  // Nodes not yet reached at each step are dimmed.
  const FIRST_ACTIVE: Record<string, number> = { trig: 0, agent: 1, search: 2, md: 1, site: 4 };

  function initPipeline(root: HTMLElement) {
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const $$ = <T extends Element = HTMLElement>(sel: string) => [...root.querySelectorAll<T>(sel)];

    const nodes = $$('[data-node]');
    const flows = $$('[data-flow]');
    const captions = $$('[data-caption]');
    const buttons = $$<HTMLButtonElement>('[data-goto]');
    const chips = $$('[data-chip]');
    const lines = $$('[data-line]');
    const archives = $$('[data-archive]');
    const prs = $$('[data-pr]');
    const setText = (sel: string, text: string) => $$(sel).forEach((el) => (el.textContent = text));
    const toggle = $<HTMLButtonElement>('[data-toggle]');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let step = 0;
    let paused = reduceMotion;
    let progress: gsap.core.Tween | undefined;

    // Zoom the fixed-size stage to fit its container.
    const wrap = $('[data-stage-wrap]');
    const stage = $('[data-stage]');
    const fit = () => {
      stage.style.zoom = String(Math.min(1, wrap.clientWidth / 1040));
    };
    const resize = new ResizeObserver(fit);
    resize.observe(wrap);

    function show(next: number) {
      step = next;
      const state = STATES[step];

      for (const node of nodes) {
        const id = node.dataset.node!;
        node.classList.toggle('is-on', state.on.includes(id));
        node.classList.toggle('is-dim', step < FIRST_ACTIVE[id]);
      }
      for (const flow of flows) {
        flow.classList.toggle('is-flowing', state.flow.includes(flow.dataset.flow!));
      }
      setText('[data-agent-status]', state.agent);
      setText('[data-md-status]', state.md);
      setText('[data-site-status]', state.site);

      captions.forEach((c, i) => c.classList.toggle('is-active', i === step));
      gsap.fromTo(captions[step], { opacity: 0, x: 12 }, { opacity: 1, x: 0, duration: 0.5, ease: 'expo.out' });

      // Flourishes.
      gsap.killTweensOf([...chips, ...lines, ...archives, ...prs]);
      if (step === 2) {
        gsap.fromTo(chips, { opacity: 0, y: 10, scale: 0.92 }, { opacity: 1, y: 0, scale: 1, duration: 0.5, stagger: 0.2, ease: 'expo.out' });
      } else {
        gsap.to(chips, { opacity: 0, duration: 0.3 });
      }
      if (step === 3) {
        gsap.fromTo(lines, { scaleX: 0 }, { scaleX: 1, duration: 0.4, stagger: 0.25, ease: 'steps(8)' });
        gsap.fromTo(archives, { x: 0, y: 0, rotate: 0, opacity: 1 }, { x: -14, y: -10, rotate: -6, opacity: 0.55, duration: 0.9, delay: 0.9, ease: 'power2.inOut' });
      } else {
        gsap.set(lines, { scaleX: 1 });
        gsap.to(archives, { x: 0, y: 0, rotate: 0, opacity: 1, duration: 0.4 });
      }
      if (step === 4) {
        gsap.fromTo(prs, { opacity: 0, scale: 0.7 }, { opacity: 1, scale: 1, duration: 0.55, ease: 'back.out(2)' });
      } else if (step < 4) {
        gsap.to(prs, { opacity: 0, duration: 0.3 });
      }

      // Step buttons: earlier steps filled, the current one fills over time.
      buttons.forEach((b, i) => {
        b.setAttribute('aria-current', i === step ? 'step' : 'false');
        gsap.set(b.querySelector('[data-done]'), { scaleX: i < step ? 1 : 0 });
        gsap.set(b.querySelector('[data-fill]'), { scaleX: 0 });
      });
      progress?.kill();
      progress = gsap.fromTo(
        buttons[step].querySelector('[data-fill]'),
        { scaleX: 0 },
        {
          scaleX: 1,
          duration: STEP_SECONDS,
          ease: 'none',
          paused,
          onComplete: () => show((step + 1) % STATES.length),
        },
      );
    }

    function setPaused(value: boolean) {
      paused = value;
      if (paused) progress?.pause();
      else progress?.play();
      $('[data-toggle-label]').textContent = paused ? 'Play' : 'Pause';
      $('[data-icon-pause]').classList.toggle('hidden', paused);
      $('[data-icon-play]').classList.toggle('hidden', !paused);
    }

    buttons.forEach((b, i) => b.addEventListener('click', () => show(i)));
    toggle.addEventListener('click', () => setPaused(!paused));

    show(0);
    setPaused(paused);

    return () => {
      resize.disconnect();
      progress?.kill();
      gsap.killTweensOf(root.querySelectorAll('*'));
    };
  }

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-pipeline]');
    if (!root) return;
    const cleanup = initPipeline(root);
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  });
</script>
