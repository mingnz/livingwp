---
import { SITE_NAME } from '../lib/site';

const nav = [
  { href: '/whitepaper/', label: 'Articles' },
  { href: '/how-it-works/', label: 'How it works' },
  { href: '/about/', label: 'About' },
];

const current = Astro.url.pathname;
---

<header>
  <div class="brand-strip" aria-hidden="true"></div>
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-8 gap-y-1 px-5 py-4 sm:px-8 sm:py-5"
  >
    <a href="/" class="text-[1.375rem] font-bold tracking-tight hover:text-teal">
      {SITE_NAME}
    </a>
    <nav aria-label="Main" class="-mx-3 flex flex-wrap text-[0.95rem] font-medium">
      {
        nav.map(({ href, label }) => {
          const active = current.startsWith(href);
          return (
            <a
              href={href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'border-b-2 px-3 py-3 transition-colors',
                active
                  ? 'border-lime text-ink'
                  : 'border-transparent text-ink-muted hover:text-ink',
              ]}
            >
              {label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
