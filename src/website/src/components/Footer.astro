---
import {
  GITHUB_URL,
  ORG_NAME,
  ORG_NAME_MI,
  ORG_URL,
  WORKING_GROUP,
  feedbackUrl,
} from '../lib/site';

const columns = [
  {
    heading: 'Project',
    links: [
      { href: '/whitepaper/', label: 'Articles' },
      { href: '/how-it-works/', label: 'How it works' },
      { href: '/about/', label: 'About' },
    ],
  },
  {
    heading: 'Elsewhere',
    links: [
      { href: GITHUB_URL, label: 'GitHub' },
      { href: '/feed.xml', label: 'RSS feed' },
      { href: feedbackUrl(), label: 'Report a problem' },
    ],
  },
];
---

<footer class="bg-ink text-on-ink">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-[2fr_1fr_1fr] sm:px-8">
    <div>
      <p class="text-xl font-bold text-white">{WORKING_GROUP}</p>
      <p class="mt-1.5">
        <a href={ORG_URL} class="hover:text-white">{ORG_NAME}</a> · {ORG_NAME_MI}
      </p>
      <p class="mt-5 max-w-md text-[0.95rem] leading-relaxed text-on-ink-muted">
        A monthly record of AI adoption across Aotearoa New Zealand, researched and
        written by an AI agent. Every run is public on GitHub.
      </p>
    </div>
    {
      columns.map(({ heading, links }) => (
        <div>
          <p class="text-xs font-semibold tracking-[0.08em] text-on-ink-faint uppercase">
            {heading}
          </p>
          <ul class="mt-3 space-y-1">
            {links.map(({ href, label }) => (
              <li>
                <a href={href} class="inline-block py-1 text-lime-soft hover:text-white">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</footer>
