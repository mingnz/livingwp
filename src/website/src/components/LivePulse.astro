---
interface Props {
  label?: string;
}
const { label } = Astro.props;
---

<span class="inline-flex items-center gap-2">
  <span class="relative flex size-2">
    <span class="bg-pounamu animate-pulse-ring absolute inline-flex size-full rounded-full"
    ></span>
    <span class="bg-pounamu relative inline-flex size-2 rounded-full"></span>
  </span>
  {label && <span>{label}</span>}
</span>
