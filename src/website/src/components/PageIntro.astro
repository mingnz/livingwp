---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="mx-auto max-w-6xl px-5 pt-14 pb-12 sm:px-8 sm:pt-16">
  <h1 class="rise text-[clamp(2.75rem,6vw,4.75rem)] leading-none font-bold tracking-[-0.04em]">
    {title}
  </h1>
  {
    Astro.slots.has('default') && (
      <p
        class="rise mt-6 max-w-3xl font-serif text-xl leading-normal text-ink-soft sm:text-[1.375rem]"
        style="--delay: 0.08s"
      >
        <slot />
      </p>
    )
  }
</section>
