---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="py-24 text-center sm:py-32">
    <p class="font-display text-pounamu-deep/20 text-[7rem] leading-none font-semibold sm:text-[10rem]">
      404
    </p>
    <h1 class="font-display mt-4 text-2xl font-semibold tracking-tight">
      This page doesn't exist.
    </h1>
    <p class="text-ink-muted mt-3">It may have been moved or removed.</p>
    <a
      href="/"
      class="font-mono text-pounamu-deep hover:text-pounamu mt-8 inline-block text-[0.72rem] tracking-[0.14em] uppercase underline decoration-pounamu/40 underline-offset-4 transition-colors"
    >
      Go to the homepage
    </a>
  </section>
</Base>
