---
import Base from '../layouts/Base.astro';
import SectorGrid from '../components/SectorGrid.astro';
import {
  formatDate,
  formatMonthYear,
  getAllArticles,
  getIndustryReports,
  getLatestSnapshot,
  summaryOf,
} from '../lib/articles';

const editions = await getAllArticles();
const reports = await getIndustryReports();
const snapshot = await getLatestSnapshot();
const lastUpdated = new Date(
  Math.max(...editions.map((a) => a.data.article_updated_at.getTime())),
);
const firstPublished = new Date(
  Math.min(...editions.map((a) => a.data.article_updated_at.getTime())),
);
const firstMonth = formatMonthYear(firstPublished);

const stats = [
  { value: String(reports.length), label: 'Sector reports' },
  { value: String(editions.length), label: `Editions since ${firstMonth}` },
  { value: 'Monthly', label: 'Update cadence' },
];

const steps = [
  {
    title: 'Research',
    body: 'The agent reads the current edition, then searches the web for what has changed since.',
    dot: 'bg-lime text-ink',
  },
  {
    title: 'Rewrite',
    body: 'It writes a new edition with sources cited inline. The previous edition moves to the archive, unchanged.',
    dot: 'bg-teal-bright text-ink',
  },
  {
    title: 'Publish',
    body: 'The change merges as a public pull request on GitHub, and the site updates.',
    dot: 'bg-teal text-white',
  },
];
---

<Base description="The latest national AI snapshot and sector reports on AI adoption across Aotearoa New Zealand.">
  <section class="mx-auto max-w-6xl px-5 pt-14 pb-14 sm:px-8 sm:pt-20">
    <p
      class="rise flex items-center gap-3 text-sm font-semibold tracking-[0.08em] text-teal uppercase"
    >
      <span class="live-dot"></span>
      Latest edition · {formatDate(lastUpdated)}
    </p>
    <h1
      class="rise mt-6 max-w-5xl text-[clamp(3rem,7vw,6rem)] leading-[0.98] font-bold tracking-[-0.04em] text-balance"
      style="--delay: 0.08s"
    >
      How Aotearoa is adopting AI, <span class="mark">sector by sector.</span>
    </h1>
    <p
      class="rise mt-8 max-w-2xl font-serif text-xl leading-normal text-ink-soft sm:text-2xl"
      style="--delay: 0.18s"
    >
      An AI agent researches and rewrites this resource at the start of every month:
      a national snapshot, plus a report on each of {reports.length} sectors.
    </p>
  </section>

  {
    snapshot && (
      <section class="rise mx-auto max-w-6xl px-5 sm:px-8" style="--delay: 0.3s">
        <article class="grid overflow-hidden rounded-3xl bg-mist md:grid-cols-[3fr_2fr]">
          <div class="flex flex-col gap-5 p-8 sm:p-12">
            <span class="self-start rounded-full bg-ink px-3.5 py-1.5 text-[0.8rem] font-semibold tracking-wide text-white">
              National snapshot
            </span>
            <h2 class="text-4xl leading-[1.05] font-bold tracking-[-0.03em] sm:text-[2.75rem]">
              <a href={snapshot.data.permalink} class="hover:text-teal">
                {snapshot.data.title}
              </a>
            </h2>
            <p class="font-serif text-xl leading-normal text-ink-soft">{summaryOf(snapshot)}</p>
            <div class="mt-2 flex flex-wrap gap-3">
              <a
                href={snapshot.data.permalink}
                class="rounded-full bg-teal px-6 py-3.5 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-teal-deep"
              >
                Read the snapshot
              </a>
              <a
                href="/whitepaper/#past-editions"
                class="rounded-full border-[1.5px] border-teal px-6 py-3.5 font-semibold text-teal transition hover:bg-white"
              >
                Past editions
              </a>
            </div>
          </div>
          <dl class="flex flex-col justify-center gap-8 bg-teal p-8 text-white sm:p-12">
            {
              stats.map(({ value, label }) => (
                <div class="flex flex-col-reverse gap-1">
                  <dt class="text-sm font-semibold tracking-[0.08em] text-teal-mint uppercase">
                    {label}
                  </dt>
                  <dd class="text-5xl font-bold tracking-tight">{value}</dd>
                </div>
              ))
            }
          </dl>
        </article>
      </section>
    )
  }

  <section class="mx-auto max-w-6xl px-5 pt-24 pb-20 sm:px-8 sm:pt-28">
    <div
      class="flex flex-wrap items-baseline justify-between gap-4 border-b-2 border-ink pb-5"
    >
      <h2 class="text-4xl font-bold tracking-[-0.03em]">Sector reports</h2>
      <a href="/whitepaper/" class="py-2 font-medium text-teal hover:text-teal-deep">
        All articles and past editions →
      </a>
    </div>
    <div class="mt-8">
      <SectorGrid />
    </div>
  </section>

  <section class="-mb-24 bg-mist">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 sm:px-8 md:grid-cols-4">
      <h2 data-reveal class="text-4xl leading-tight font-bold tracking-[-0.03em]">
        Researched by AI, auditable by anyone
      </h2>
      {
        steps.map(({ title, body, dot }, i) => (
          <div data-reveal style={`--delay: ${(i + 1) * 0.1}s`} class="flex flex-col gap-2.5">
            <span class:list={['flex size-10 items-center justify-center rounded-full font-bold', dot]}>
              {i + 1}
            </span>
            <h3 class="mt-2 text-xl font-semibold">{title}</h3>
            <p class="font-serif text-lg leading-normal text-ink-soft">{body}</p>
          </div>
        ))
      }
    </div>
    <div class="mx-auto max-w-6xl px-5 pb-20 sm:px-8">
      <a href="/how-it-works/" class="font-semibold text-teal underline decoration-lime decoration-2 underline-offset-4 hover:text-teal-deep">
        See how it works
      </a>
    </div>
  </section>
</Base>
