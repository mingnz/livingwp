---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import EditionHistory from '../components/EditionHistory.astro';
import ogImage from '../assets/ainz.jpg';
import { articleNode } from '../lib/seo';
import { feedbackUrl } from '../lib/site';
import {
  formatDate,
  getAllArticles,
  getIndustryReports,
  getLatestSnapshot,
  getSeriesHistory,
  permalinkToSlug,
  shortTitle,
  summaryOf,
  type Article,
} from '../lib/articles';

export async function getStaticPaths() {
  // Routes derive from the permalink frontmatter field — never from file
  // paths — so published URLs are stable by construction.
  const articles = await getAllArticles();
  return articles.map((entry) => ({
    params: { slug: permalinkToSlug(entry.data.permalink) },
    props: { entry },
  }));
}

interface Props {
  entry: Article;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);

const history = await getSeriesHistory(data.article_series);
const position = history.findIndex((e) => e.id === entry.id);
const editionNumber = history.length - position;
const latest = history[0];
const isLatest = data.article_latest;

const summary = summaryOf(entry);
const canonical = new URL(data.permalink, Astro.site);
const articleSchema = articleNode(Astro.site!, {
  url: canonical,
  headline: data.title,
  description: summary,
  // First edition in the series = original publication; this edition = modified.
  datePublished: history[history.length - 1].data.article_updated_at,
  dateModified: data.article_updated_at,
  image: new URL(ogImage.src, Astro.site),
});

// Clean-markdown view for AI crawlers and "copy as markdown"; latest editions only.
const markdownUrl = isLatest ? `/whitepaper/${data.article_series}.md` : undefined;

// Articles publish without review, so give readers a direct feedback channel.
const reportUrl = feedbackUrl({
  title: `Article feedback: ${data.title} (${formatDate(data.article_updated_at)} edition)`,
  articleUrl: canonical.href,
});

// Keep reading: the snapshot (unless we're on it), then the next reports A–Z.
const snapshot = await getLatestSnapshot();
const reports = await getIndustryReports();
const start = reports.findIndex((r) => r.data.article_series === data.article_series) + 1;
const rotated = [...reports.slice(start), ...reports.slice(0, start)].filter(
  (r) => r.data.article_series !== data.article_series,
);
const keepReading = [
  ...(snapshot && snapshot.data.article_series !== data.article_series ? [snapshot] : []),
  ...rotated,
].slice(0, 3);
---

<Base
  title={data.title}
  description={data.description ?? summary}
  noindex={!isLatest}
  jsonLd={[articleSchema]}
>
  <div aria-hidden="true" class="sticky top-0 z-10 h-1">
    <div class="reading-progress h-1 bg-lime"></div>
  </div>

  <section class="bg-mist">
    <div class="mx-auto max-w-6xl px-5 pt-10 pb-12 sm:px-8 sm:pt-12 sm:pb-14">
      <nav aria-label="Breadcrumb" class="flex gap-2 text-sm text-ink-muted">
        <a href="/whitepaper/" class="hover:text-teal">Articles</a>
        <span aria-hidden="true">/</span>
        <span>{shortTitle(data.title)}</span>
      </nav>

      {
        !isLatest && (
          <div class="rise mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 rounded-2xl bg-amber-pale px-5 py-4 text-amber-ink">
            <p class="flex-[1_1_20rem]">
              You’re reading the {formatDate(data.article_updated_at)} edition. The latest
              edition is from {formatDate(latest.data.article_updated_at)}.
            </p>
            <a
              href={latest.data.permalink}
              class="rounded-full bg-ink px-4.5 py-2.5 text-[0.95rem] font-semibold text-white hover:bg-teal"
            >
              Read the latest edition
            </a>
          </div>
        )
      }

      <div class="rise mt-7 flex flex-wrap items-center gap-x-4 gap-y-2">
        {
          isLatest ? (
            <span class="inline-flex items-center gap-2 rounded-full bg-ink px-3.5 py-1.5 text-[0.8rem] font-semibold tracking-wide text-white">
              <span class="live-dot" />
              Latest edition
            </span>
          ) : (
            <span class="rounded-full bg-amber px-3.5 py-1.5 text-[0.8rem] font-semibold tracking-wide text-amber-deep">
              Archived edition
            </span>
          )
        }
        <span class="text-[0.95rem] text-ink-soft">
          {isLatest ? 'Updated' : 'Published'}
          <time datetime={data.article_updated_at.toISOString()}>
            {formatDate(data.article_updated_at)}
          </time>
          · Edition {editionNumber} of {history.length}
        </span>
      </div>

      <h1
        class="rise mt-5 max-w-4xl text-[clamp(2.75rem,6vw,4.75rem)] leading-none font-bold tracking-[-0.04em] text-balance"
        style="--delay: 0.08s"
      >
        {data.title}
      </h1>
      {
        summary && (
          <p
            class="rise mt-6 max-w-3xl font-serif text-xl leading-snug text-ink-soft sm:text-2xl"
            style="--delay: 0.16s"
          >
            {summary}
          </p>
        )
      }
      <div class="rise mt-7 flex flex-wrap gap-2.5" style="--delay: 0.24s">
        <a
          href={reportUrl}
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-full border-[1.5px] border-line-strong bg-white px-4.5 py-2.5 text-[0.95rem] font-medium transition hover:-translate-y-0.5 hover:border-teal-bright"
        >
          <svg class="size-4" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3 14V2.5M3 3h8l-1.5 3L11 9H3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
          </svg>
          Report a problem
        </a>
        {
          markdownUrl && (
            <a
              href={markdownUrl}
              class="inline-flex items-center gap-2 rounded-full border-[1.5px] border-line-strong bg-white px-4.5 py-2.5 text-[0.95rem] font-medium transition hover:-translate-y-0.5 hover:border-teal-bright"
            >
              <svg class="size-4" viewBox="0 0 16 16" aria-hidden="true">
                <rect x="1.5" y="3.5" width="13" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"></rect>
                <path d="M4 10V6l2 2 2-2v4M11 6v4M9.5 8.5L11 10l1.5-1.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              View as Markdown
            </a>
          )
        }
      </div>
    </div>
  </section>

  <div
    class="mx-auto grid max-w-6xl gap-12 px-5 pt-14 sm:px-8 lg:grid-cols-[12rem_minmax(0,1fr)_16rem] lg:gap-10 xl:gap-14"
  >
    {
      sections.length > 1 && (
        <nav aria-label="On this page" class="hidden lg:block">
          <div class="sticky top-8">
            <p class="text-xs font-semibold tracking-[0.08em] text-ink-muted uppercase">On this page</p>
            <ol class="mt-3.5 text-[0.95rem]" data-toc>
              {sections.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    class="block border-l-[3px] border-line-soft py-2 pl-3 text-ink-muted transition-all hover:border-teal-bright hover:pl-4 hover:text-ink aria-[current=true]:border-lime aria-[current=true]:font-semibold aria-[current=true]:text-ink"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </nav>
      )
    }

    <article class="article-prose min-w-0 lg:col-start-2" data-article>
      <Content />
    </article>

    <aside class="lg:col-start-3">
      <div class="lg:sticky lg:top-8">
        <EditionHistory entry={entry} />
      </div>
    </aside>
  </div>

  <section class="mx-auto mt-20 grid max-w-6xl gap-5 px-5 sm:px-8 md:grid-cols-2">
    <div data-reveal class="flex flex-col gap-3.5 rounded-3xl bg-teal p-9 text-white">
      <h2 class="text-3xl leading-tight font-bold tracking-tight">Spot something wrong?</h2>
      <p class="font-serif text-lg leading-normal text-teal-pale">
        An AI agent wrote this edition, and no one reviewed it before it went live.
        Reporting a problem opens a public issue on GitHub.
      </p>
      <a
        href={reportUrl}
        rel="noopener"
        class="mt-1.5 self-start rounded-full bg-lime px-6 py-3.5 font-semibold text-ink transition hover:-translate-y-0.5 hover:bg-lime-soft"
      >
        Report a problem
      </a>
    </div>
    <div data-reveal style="--delay: 0.1s" class="rounded-3xl bg-mist p-9">
      <h2 class="text-3xl leading-tight font-bold tracking-tight">Keep reading</h2>
      <ul class="mt-3">
        {
          keepReading.map((a, i) => (
            <li class:list={[i < keepReading.length - 1 && 'border-b border-line']}>
              <a
                href={a.data.permalink}
                class="group flex items-center justify-between gap-4 py-3.5 text-lg font-medium hover:text-teal"
              >
                {a.data.title}
                <Arrow class="text-teal transition-transform group-hover:translate-x-1" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<script>
  // Highlight the "On this page" entry for the section in view.
  function initToc() {
    const toc = document.querySelector('[data-toc]');
    const article = document.querySelector('[data-article]');
    if (!toc || !article) return;
    const links = new Map(
      [...toc.querySelectorAll<HTMLAnchorElement>('a')].map((a) => [a.hash.slice(1), a]),
    );
    const headings = [...article.querySelectorAll<HTMLElement>('h2[id]')].filter((h) =>
      links.has(h.id),
    );
    const setCurrent = (id: string) =>
      links.forEach((a, key) => a.setAttribute('aria-current', String(key === id)));

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length) setCurrent(visible[0].target.id);
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    headings.forEach((h) => observer.observe(h));
    if (headings[0]) setCurrent(headings[0].id);
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }

  document.addEventListener('astro:page-load', initToc);
</script>
