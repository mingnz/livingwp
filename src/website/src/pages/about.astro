---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { GITHUB_URL, ORG_NAME, ORG_NAME_MI, ORG_URL, WORKING_GROUP } from '../lib/site';

const link = 'underline decoration-lime decoration-2 underline-offset-4 hover:text-teal-deep';

const site = new URL('/', Astro.site).href.replace(/\/$/, '');
const agentPrompt = `I want to suggest a change to the Living Whitepaper, an open-source project that publishes monthly reports on AI adoption in Aotearoa New Zealand.

Website: ${site} (an index for AI agents is at ${site}/llms.txt)
Code: ${GITHUB_URL}

My suggestion: [describe it in your own words]

Read the repository's README and AGENTS.md, work out where this change belongs, and explain what you would change and why. Then help me submit it: as a pull request if you can, or as a GitHub issue I can copy and paste.`;

const agentSteps = [
  {
    title: 'Open an AI agent',
    body: 'Any coding agent works: Claude Code, Codex, GitHub Copilot, Cursor and others. A chat assistant that can browse the web works too.',
  },
  {
    title: 'Paste the prompt',
    body: 'Copy the prompt below and replace the bracketed line with your idea, in plain language.',
  },
  {
    title: 'Review and submit',
    body: 'The agent reads the project, proposes a change and helps you open a pull request or an issue. The maintainers review it from there.',
  },
];
---

<Base
  title="About"
  description={`About the ${ORG_NAME} ${WORKING_GROUP} and the Living Whitepaper project.`}
>
  <section class="mx-auto flex max-w-6xl flex-wrap items-start gap-14 px-5 pt-14 sm:px-8 sm:pt-16">
    <div class="max-w-3xl min-w-0 flex-[999_1_32rem]">
      <h1 class="rise text-[clamp(2.75rem,6vw,4.75rem)] leading-none font-bold tracking-[-0.04em]">
        About
      </h1>
      <div class="rise mt-8 space-y-5 font-serif text-xl leading-relaxed text-ink-soft" style="--delay: 0.08s">
        <p>
          The {WORKING_GROUP} is part of the <a href={ORG_URL} class={link}>{ORG_NAME}</a>.
          It explores developments in AI and shares what it learns with the wider community.
        </p>
        <p>
          The Living Whitepaper is one of its projects: a monthly record of how sectors
          across Aotearoa New Zealand are adopting AI. An AI agent researches, writes and
          publishes every report. No one reviews an edition before it goes live. Instead,
          each run leaves a public audit trail on GitHub, and every article has a link to
          report a problem.
        </p>
        <p>
          The project is open source. The prompts, workflows and code are all on
          <a href={GITHUB_URL} class={link}>GitHub</a>, and contributions are welcome,
          including <a href="#contribute" class={link}>ones made with an AI agent</a>.
        </p>
      </div>
    </div>

    <aside class="flex flex-[1_1_18rem] flex-col gap-4">
      <a
        href={ORG_URL}
        data-reveal
        style="--delay: 0.2s"
        class="card-lift flex flex-col gap-2 rounded-[1.25rem] bg-teal p-7 text-white"
      >
        <span class="text-[13px] font-semibold tracking-[0.08em] text-teal-mint uppercase">Published by</span>
        <span class="text-2xl font-bold tracking-tight">{WORKING_GROUP}</span>
        <span class="text-teal-pale">{ORG_NAME} · {ORG_NAME_MI}</span>
        <span class="mt-2 flex items-center gap-1.5 font-semibold text-lime-soft">aiforum.org.nz <Arrow /></span>
      </a>
      <a
        href={GITHUB_URL}
        data-reveal
        style="--delay: 0.3s"
        class="card-lift flex flex-col gap-2 rounded-[1.25rem] border-[1.5px] border-line p-7 hover:border-teal-bright"
      >
        <span class="text-xl font-semibold">Open source</span>
        <span class="leading-normal text-ink-soft">Read the prompts and agent code, or ask an AI agent to suggest a change for you.</span>
        <span class="mt-1 flex items-center gap-1.5 font-semibold text-teal">View on GitHub <Arrow /></span>
      </a>
      <a
        href="/feed.xml"
        data-reveal
        style="--delay: 0.4s"
        class="card-lift flex flex-col gap-2 rounded-[1.25rem] bg-mist p-7"
      >
        <span class="text-xl font-semibold">Stay up to date</span>
        <span class="leading-normal text-ink-soft">Get each new edition in your feed reader on the 1st of the month.</span>
        <span class="mt-1 flex items-center gap-1.5 font-semibold text-teal">Subscribe via RSS <Arrow /></span>
      </a>
    </aside>
  </section>

  <section id="contribute" class="mx-auto max-w-6xl scroll-mt-8 px-5 pt-24 sm:px-8">
    <h2 class="border-b-2 border-ink pb-5 text-4xl font-bold tracking-[-0.03em]">
      Suggest a change with an AI agent
    </h2>
    <p class="mt-6 max-w-3xl font-serif text-xl leading-normal text-ink-soft">
      You don’t need to know how the code works to help. Point your favourite AI agent at
      the project, describe what you would change, and let it do the technical work. It
      can fix a report, add a sector, improve a prompt or tidy the website.
    </p>

    <ol class="mt-10 grid gap-8 md:grid-cols-3">
      {
        agentSteps.map(({ title, body }, i) => (
          <li data-reveal style={`--delay: ${i * 0.1}s`} class="flex flex-col gap-2.5">
            <span class="flex size-10 items-center justify-center rounded-full bg-lime font-bold">
              {i + 1}
            </span>
            <h3 class="mt-2 text-xl font-semibold">{title}</h3>
            <p class="font-serif text-lg leading-normal text-ink-soft">{body}</p>
          </li>
        ))
      }
    </ol>

    <figure data-reveal class="mt-10 overflow-hidden rounded-3xl bg-ink text-on-ink">
      <figcaption class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 px-6 py-4">
        <span class="text-sm font-semibold tracking-[0.08em] text-on-ink-faint uppercase">
          Prompt to copy
        </span>
        <button
          type="button"
          class="inline-flex h-11 items-center gap-2 rounded-full bg-lime px-5 text-sm font-semibold text-ink transition hover:bg-lime-soft"
          data-copy-prompt
        >
          <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <rect x="5" y="5" width="9" height="9" rx="1.5"></rect>
            <path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"></path>
          </svg>
          <span data-copy-label>Copy prompt</span>
        </button>
      </figcaption>
      <pre
        class="overflow-x-auto px-6 py-5 font-sans text-[0.95rem] leading-relaxed whitespace-pre-wrap"
        data-prompt>{agentPrompt}</pre>
    </figure>
  </section>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const button = document.querySelector<HTMLButtonElement>('[data-copy-prompt]');
    const prompt = document.querySelector('[data-prompt]');
    const label = button?.querySelector('[data-copy-label]');
    if (!button || !prompt || !label) return;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(prompt.textContent ?? '');
        label.textContent = 'Copied';
      } catch {
        label.textContent = 'Select the text to copy';
      }
      setTimeout(() => (label.textContent = 'Copy prompt'), 2000);
    });
  });
</script>
