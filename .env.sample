# Provider API key for the research agent. Only the key for the provider
# referenced by your configured research model is required.
#
# Bare model names (e.g. "gpt-5.4-2026-03-05") use OpenAI; prefix with
# "anthropic/" or "google/" to use those providers.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional overrides (defaults shown). Also settable as repo CI variables.
# RESEARCH_MODEL=gpt-5.4-2026-03-05
# RESEARCH_INSTRUCTIONS_FILENAME=instructions_research.md
# STREAMING_ENABLED=True
